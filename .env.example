# Copy this file to `.env` and fill in real values. `.env` is git-ignored -
# never commit it. Nothing in this file is a real secret.

# --- PostgreSQL --------------------------------------------------------
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- Supabase Studio (Studio-only mode: no Kong/Auth/Storage/Realtime) ---
# postgres-meta needs a 32+ char value here to encrypt Vault secrets. We
# don't use Vault in this setup, so any long random string works -
# generate one with `openssl rand -hex 16` (or similar).
PG_META_CRYPTO_KEY=replace-with-32-plus-random-chars
# These three don't connect to anything real (there's no Kong/GoTrue in
# this stack) - they exist only so Studio's UI doesn't error rendering
# panels that expect them. Table Editor / SQL Editor / Database tabs don't
# need these to work. Any string is fine; JWT_SECRET should be 32+ chars.
JWT_SECRET=replace-with-32-plus-random-chars
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_KEY=replace-me
STUDIO_DEFAULT_ORGANIZATION=Dev Organization
STUDIO_DEFAULT_PROJECT=app

# --- Cloudflare Tunnel ---------------------------------------------------
# Token for a tunnel you created with `cloudflared tunnel create` (or in the
# Zero Trust dashboard under Networks > Tunnels). See README.md for the full
# setup steps, including pointing the tunnel's public hostname at
# http://app:3000.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-tunnel-token

# --- App's Supabase client (src/supabase.js) ------------------------------
SUPABASE_URL=replace-me
SUPABASE_PUBLISHABLE_KEY=replace-me
SUPABASE_SECRET_KEY=replace-me
SUPABASE_JWKS_URL=replace-me

# --- Auth0 (backend token verification) -----------------------------------
AUTH0_DOMAIN=replace-with-your-tenant.us.auth0.com
AUTH0_AUDIENCE=replace-with-your-api-identifier

# --- Gemini (product placeholder images) - not wired up yet, key TBD ------
GEMINI_API_KEY=replace-me

# --- SSH into the app container (reachable over Tailscale only, :2222) ---
APP_SSH_USER=server
APP_SSH_PASSWORD=change-me

# --- Tailscale ------------------------------------------------------------
# A reusable or one-off auth key from https://login.tailscale.com/admin/settings/keys
# Recommended for a temporary dev stack: check "Ephemeral" so the node
# disappears from your tailnet automatically when the container stops, and
# set a short expiry.
TS_AUTHKEY=tskey-auth-replace-with-your-key
# Name this node will show up as in your tailnet / MagicDNS.
TS_HOSTNAME=studio-dev
