# Copy this file to `.env` (in this gui/ folder) and fill in real values.
# `.env` is git-ignored - never commit it. Nothing in this file is a real
# secret.
#
# These are the same Auth0 SPA application values configured server-side
# in the root .env as AUTH0_DOMAIN / AUTH0_Client_ID / AUTH0_AUDIENCE - when
# running through docker-compose, docker-compose.yml's `gui` service maps
# those into these VITE_-prefixed names for you and this file isn't used.
# Vite only exposes env vars prefixed VITE_ to client-side code.

VITE_AUTH0_DOMAIN=replace-with-your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=replace-with-your-spa-client-id
VITE_AUTH0_AUDIENCE=replace-with-your-api-identifier
