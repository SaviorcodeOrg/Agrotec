# Dockerfile.gui - development image for the Vite/React frontend.
#
# gui/ used to live in its own separate GitHub repo, which is why this used
# to clone/pull it at container start instead of copying source in at build
# time. Since "Unificar gui/ en el mismo repo bajo main", gui/ is part of
# this same monorepo and docker-compose.yml bind-mounts it straight into
# /app - gui-entrypoint.sh just `npm install && npm run dev`s it there, no
# git involved.

FROM node:22-alpine

# tini for clean signal handling (see Dockerfile for the full rationale).
RUN apk add --no-cache tini

WORKDIR /app

COPY gui-entrypoint.sh /usr/local/bin/gui-entrypoint.sh
RUN chmod +x /usr/local/bin/gui-entrypoint.sh

EXPOSE 5173

ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/gui-entrypoint.sh"]
